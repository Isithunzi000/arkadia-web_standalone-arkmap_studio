    {
      "label": "Usunięcie pokoju \"4379\" (#4379)",
      "payload": {
        "room": {
          "env": 271,
          "id": 4379,
          "name": "4379",
          "special_exits": {
            "karczma": 4362
          },
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Jedynym zrodlem swiatla w tym pomieszczeniu jest niewielki kaganek stojacy na niskiej szafce u wezglowia drewnianego lozka. Pomieszczenie to najwyrazniej przeznaczone jest dla gosci chcacych przenocowac we wsi lecz trudno sobie nawet wyobrazic jak mozna zasnac przy halasie, jaki dobiega z pomieszczenia obok. Procz lozka i szafki w pokoiku nie znajduje sie nic wiecej, nie ma nawet okien przez ktore mogloby wpadac troche swiezego powietrza. Jedyne wyjscie prowadzi stad do glownej sali karczmy.\"],\"room_id\":4379}]",
            "internal_id": "if312cb91a"
          },
          "x": 119,
          "y": -45,
          "z": 0
        }
      },
      "seq": 82,
      "target": {
        "areaId": 21,
        "roomId": 4379
      },
      "type": "DELETE_ROOM"
    },
