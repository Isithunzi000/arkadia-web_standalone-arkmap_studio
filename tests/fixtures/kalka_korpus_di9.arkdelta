    {
      "label": "Usunięcie pokoju \"8242\" (#8242)",
      "payload": {
        "room": {
          "env": 271,
          "exits": {
            "ne": 8236,
            "nw": 8238,
            "se": 8243
          },
          "id": 8242,
          "name": "8242",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Nieliczne skalne lachy i grupy glazow niczym wyspy wyrastaja sposrod gesto pokrywajacej te zbocza kosodrzewiny. Jej zwarte galezie i wiecznie zielone igly stanowia bariere praktycznie nie do pokonania, co bardzo utrudnia podroz. Kilkaset metrow ponad tym pasmem gor stoki pustoszeja, przechodzac w wysokogorskie turzycowe hale, a jeszcze wyzej - w skaliste turnie, granie i szczyty. Przy jednej z bujniejszych sosnowych kep ktos wzniosl niewysoki, lecz solidnie wygladajacy szalas.\"],\"room_id\":8242}]",
            "internal_id": "ib996af936"
          },
          "weight": 5,
          "x": 115,
          "y": -139,
          "z": 0
        }
      },
      "seq": 285,
      "target": {
        "areaId": 21,
        "roomId": 8242
