        {
          "env": 295,
          "exits": {
            "w": 5491
          },
          "hash": "38:30:0:Campogrotta",
          "id": 5494,
          "name": "Ratusz, Campogrotta",
          "user_data": {
            "description": "5495 Jestes w przestronnym, bogato zdobionym holu. Pod oknami stoja dlugie lawy wyscielane aksamitem, na podlodze lezy bogaty, wyszywany zlota nicia kobierzec, a pod sufitem wisza dwa krysztalowe zyrandole. Sciany oblozono az do sufitu kunsztownie wykonana debowa boazeria, a w oddali na podescie stoi olbrzymie biurko. Po prawej stronie, tuz pod oknem przyslonietym ciezka, pluszowa kotara stoi lakierowany stol z ksiegami. Za biurkiem dostrzegasz czesciowo zasloniete, biale drzwi zza ktorych dobiegaja dzwieki ciecia desek i przesuwania ciezkich przedmiotow.",
            "internal_id": "i10ff41c52"
          },
          "x": 38,
          "y": -30,
          "z": 0
        },
