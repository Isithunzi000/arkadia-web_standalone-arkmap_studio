        },
        {
          "env": 271,
          "exits": {
            "n": 15928
          },
          "id": 15932,
          "locked": true,
          "name": "15932",
          "symbol": "+",
          "user_data": {
            "dir_bind": "north=n",
            "gps": "[{\"gps_string_lines\":[\"Jest to duze pomieszczenie, prawie zupelnie pozbawione mebli. Na podlodze, niewiele czystszej niz na korytarzu, lezy kilkanascie starych materacy, niezbyt wygodnych, ale na pewno lepszych od twardych desek. Domyslasz sie. ze jest to miejsce, w ktorym podczas wojny miedzy Rodzinami nocuja zolnierze prywatnej armii Dona, aby byc stale gotowymi do obrony jego interesow. Swiatlo dostaje sie tutaj glownie przez okna, wychodzace na wschodzie na ulice, a na poludniu na podworko za kamienica.\"],\"room_id\":15932}]",
            "internal_id": "i101eb2f04"
          },
          "x": 53,
          "y": -40,
