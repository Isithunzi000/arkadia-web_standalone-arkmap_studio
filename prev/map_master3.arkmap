        },
        {
          "env": -1,
          "exits": {
            "down": 25520
          },
          "id": 25521,
          "name": "25521",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Znajdujesz sie na samym szczycie masywnej baszty, rozswietlonej swiatlem z osmiu niewielkich okienkek strzelniczych dajacych jako taki widok na tereny wokol twierdzy. Jak dostrzegasz po chwili, ta owalna baszte zbudowano z ciosanych na krasnoludzka modle blokow ciemnego kamienia. Sufit wzmocniono wypalanymi balami drewna, i ozdobiono fantazyjnymi rzezbieniami. Pomieszczenie to spelnia w tej chwili raczej funkcje kwatery sypialnej, jednak w razie ataku moze pelnic z powodzeniem role obronno-obserwacyjna. Pod scianami stoja rzedy prostych, skapo rzezbionych w drewnie prycz, sluzacych zolnierzom Hufu za poslania. Przy kazdej pryczy stoi mala skrzynia, w ktorej ochotnicy trzymac moga swoj dobytek. Nad wejsciem zawieszono proporzec, na ktorym widnieja dwa skrzyzowane mloty w zlotym polu. W dol wioda strome, krete schody prowadzace do podnoza baszty.\"],\"room_id\":25521}]",
            "internal_id": "i5e0e6fba5"
          },
          "x": 146,
          "y": -59,
          "z": 2
        },
