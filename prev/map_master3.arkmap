          "user_data": {
            "dir_bind": "southwest=sw&east=e&south=s",
            "gps": "[{\"gps_string_lines\":[\"Drewniany wiszacy most, na ktorym sie znajdujesz, wyglada na solidna konstrukcje i chociaz wykonany zostal dawno temu, na co wskazuje stan skladajacego sie na niego drewna i sznurow, to nie nalezy obawiac sie katastrofy. Dwa wielkie, potezne slupy wbite na jego skraju zawieraja metalowe haki podrzymujace liny ciagnace sie wzdluz linii przejscia. Drugi kraniec mostu nie jest tak blisko jakby moglo sie na poczatku wydawac, wiec czeka cie interesujaca podroz nad gleboka przepascia.\"],\"area_name\":\"Pustynia Zerrikanska\",\"room_id\":18047}]",
            "internal_id": "i52f8eccda"
          },
          "x": 43,
          "y": -167,
          "z": 0
