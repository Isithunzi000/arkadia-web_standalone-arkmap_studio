        {
          "env": 200,
          "id": 15502,
          "name": "15502",
          "special_exits": {
            "wyjscie": 15501
          },
          "symbol": "K",
          "user_data": {
            "bind": "/przejrzyj",
            "bind_printable": "/przejrzyj;",
            "gps": "[{\"gps_string_lines\":[\"Sredniej wielkosci brunatny namiot nie wyroznia sie niczym szczegolnym. Plocienne sciany ozdobione zostaly jedynie klami jakiegos stwora, ktorych ulozenie przedstawia niezbyt duza podobizne gryfa, symbol Kompanii Gryfa. Po srodku pomieszczenia ustawiono dwa dlugie stoly, a przy nich lawy, na ktorych wedrowcy moga odpoczac. Pomiedzy nimi stoi dosc duza skrzynia na ekwipunek.\"],\"room_id\":15502}]",
            "internal_id": "i607b2b393"
          },
          "x": 84,
          "y": -85,
          "z": -1
        },
        {
          "env": 303,
          "exits": {
