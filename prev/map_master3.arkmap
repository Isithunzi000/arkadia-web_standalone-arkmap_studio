        {
          "env": 271,
          "exits": {
            "n": 6397
          },
          "id": 6398,
          "name": "6398",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Znajdujesz sie na niewielkim skrawku ziemi, czyms na ksztalt polanki, wykarczowanej przez podroznikow w samym sercu kepy gestych krzewow. Promienie podnoszacego sie nad horyzontem slonca od czasu do czasu przedostaja sie pomiedzy sunacymi po niebie chmurami. Gwaltowne porywy jesiennego, chlodnego wiatru unosza w gore suche liscie i tumany kurzu. Zauwazasz rowniez wypalone do zywej ziemi miejsce po setkach ognisk, palonych przez osoby, ktore zatrzymaly sie w tym dosc spokojnym miejscu, biorac pod uwage otaczajaca je okolice.\"],\"room_id\":6398}]",
            "internal_id": "i99dd42e8a"
          },
          "x": 250,
          "y": -100,
          "z": 0
        },
