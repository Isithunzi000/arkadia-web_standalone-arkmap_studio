        },
        {
          "env": 295,
          "exits": {
            "n": 6473
          },
          "id": 26286,
          "name": "26286",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Skromnie urzadzone pomieszczenie dla gosci zakonnych. Po prawej stronie w rogu stoi solidna debowa skrzynia przeznaczona na bronie, elementy uzbrojenia oraz wszelkiej masci przedmioty. Po przeciwnej dostrzegasz prosty drewniany stol z krzeslami do spozywania posilkow. Sciany pomieszczenia sa szare, bez zadnych zdobien czy obrazow. Podloge wyscielaja wilcze skory. Pokoj wydaje sie bardzo surowy w swym wygladzie, lecz zapewnia spokoj i schronienie od trudow goscinca dla gosci przybylych w zamkowe mury Zakonu Sigmara.\"],\"room_id\":26286},{\"gps_string_lines\":[\"Skromnie urzadzone pomieszczenie dla gosci zakonnych. Po prawej stronie w rogu stoi solidna debowa skrzynia\"],\"room_id\":26286}]",
            "internal_id": "ic624a5148"
          },
          "x": 114,
          "y": -59,
          "z": 0
        },
