        {
          "env": 272,
          "exits": {
            "n": 6465,
            "s": 24335
          },
          "id": 24334,
          "name": "24334",
          "user_data": {
            "internal_id": "i622c450f1",
            "team_follow_link": "brame*n"
          },
          "x": 110,
          "y": -65,
          "z": 0
        },
        {
          "env": 272,
          "exits": {
            "e": 24336,
            "n": 24334,
            "s": 24338,
            "w": 24337
          },
          "id": 24335,
          "name": "24335",
          "symbol": "[]",
          "user_data": {
            "internal_id": "i4cd3130d4",
            "team_follow_link": "polnocy*n"
          },
          "x": 110,
          "y": -67,
          "z": 0
        },
        {
          "env": 271,
          "exits": {
            "w": 24335
          },
          "id": 24336,
          "name": "24336",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Wzdluz scian tego duzego, skromnie urzadzonego pokoju rozstawiono szerokie, twarde, wykonane z ciemnego drewna loza nalezace do gwardzistow i rycerzy zakonnych, przy nich szafki na osobiste przedmioty oraz krzesla na ubrania. Kazde starannie przykryte jest ciemna narzuta i zwierzecymi skorami, takimi samymi jak te przykrywajace kamienna podloge. Na chropowatych, surowych scianach umocowano wszelkiego rodzaju elementy rycerskiego uzbrojenia.\"],\"room_id\":24336}]",
            "internal_id": "id31e2ab41"
          },
          "x": 111,
          "y": -67,
          "z": 0
        },
        {
          "env": 271,
          "exits": {
            "e": 24335
          },
          "id": 24337,
          "name": "24337",
          "user_data": {
            "gps": "[{\"gps_string_lines\":[\"Jestes w przestronnym, surowo urzadzonym pokoju. Wzdluz jego kamiennych, chropowatych scian stoja waskie, twarde prycze starannie nakryte kocami. Panujacy tutaj polmrok rozswietlany jest w nocy przez swiece stojace w przyczepionych do scian kandelabrach, zas w ciagu dnia przez promienie slonca wpadajace przez niewielkie, waskie okienko. Panuje tu przyjemna cisza i spokoj, tak bardzo potrzebne nowicjuszom odpoczywajacym po trudach codziennych dni. Spora wspolna szafa zajmuje jeden z rogow pomieszczenia.\"],\"room_id\":24337}]",
            "internal_id": "i82389da01"
          },
          "x": 109,
          "y": -67,
          "z": 0
        },
