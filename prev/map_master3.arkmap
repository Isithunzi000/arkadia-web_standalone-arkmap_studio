          },
          "user_data": {
            "bind": "zarzuc line na belke",
            "bind_printable": "zarzuc line na belke;",
            "dir_bind": "up=wejdz na gore",
            "gps": "[{\"gps_string_lines\":[\"Czujesz jak tracisz rownowage, a podloga ucieka ci spod stop. Mimo rozpaczliwej proby zlapania sie czegos, momentalnie spadasz w dol, ciezko uderzajac o ziemie.\"],\"room_id\":23868,\"within_room_ids\":[\"23871\"]}]",
            "internal_id": "i3610487a7"
          },
          "x": 74,
          "y": -116,
          "z": 0
        },
