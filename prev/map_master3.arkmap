          "name": "8938",
          "user_data": {
            "gps": "[{\"room_id\":8938,\"gps_string_lines\":[\"Niewielka rownina rozciaga sie tuz pod traktem przecinajacym pasmo Tantullskich Wierchow, kamienne serce Mahakamu. Nieopodal dostrzegasz makabryczne resztki zniszczonej karawany kupieckiej, ktora calkiem niedawno zostala zepchnieta ze sciezki najprawdopodobniej przez lawine kamieni.\"],\"line_delta\":0}]",
            "internal_id": "i80e510af9"
          },
